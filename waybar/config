{
    "layer": "top",
    "position": "top",
    "margin-top": 8,
    "margin-left": 14,
    "margin-right": 14,
    "margin-bottom": 4,
    "height": 20,
    "spacing": 0,
    "modules-left": [
        "custom/launcher",
        "sway/workspaces",
        "custom/weather",
	    "mpd",
	    "backlight",
	    "custom/locale"
    ],
    "modules-center": [
        "custom/tbilisi_clock",
        "clock",
        "custom/nyc_clock"
    ],
    "modules-right": [
        "tray",
    	"mpris",
	    "memory",
	    // "cpu",
	    "pulseaudio",
        "network",
        "battery",
        "custom/powermenu"
    ],
    "custom/locale": {
        "exec": "~/.config/waybar/scripts/locale.sh",
        "interval": 1,
        "format": "{}",
        "tooltip": false
    },
    "sway/workspaces": {
        "all-outputs": true,
        "format": "{name}",
        "disable-click": false,
        "enable-bar": true,
        "max-width": 0,
        "min-width": 0,
        "align": "center",
    },
    "wlr/taskbar": {
        "format": "{icon}",
        "on-click": "activate",
        "on-click-right": "fullscreen",
        "icon-theme": "WhiteSur",
        "icon-size": 25,
        "tooltip-format": "{title}"
    },
    "backlight": {
        "device": "amdgpu_bl1",
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "memory": {
        "interval": 5,
        "format": "   {}% ",
        "max-length": 10
    },
    "cpu": {
        "interval": 5,
        "format": "   {}% ",
        "max-length": 10
    },
    "tray": {
        "spacing": 10
    },
    "clock": {
        "format": "   {:%a, %d %b %Y} ",
        "tooltip": true,
        "tooltip-format": "<tt>{calendar}</tt>\n",
    },
    "custom/tbilisi_clock": {
        "exec": "date +'  %H:%M RU'",
        "interval": 1,
        "tooltip": false
    },
    "custom/nyc_clock": {
        "exec": "TZ='America/New_York' date +'  %H:%M NYC'",
        "interval": 1,
        "tooltip": false
    },
    "network": {
        "format-wifi": "{icon} {essid}",
        "format-disconnected": "Disconnected ⚠ ",
        "format-icons": [
            "󰤯 ",
            "󰤟 ",
            "󰤢 ",
            "󰤥 ",
            "󰤨 "
        ],
        "tooltip-format-disconnected": "Disconnected",
        "tooltip-format-wifi": "{icon} {ipaddr}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "on-click": "~/.config/rofi/rofi-wifi-menu.sh &",
        "format-ethernet": "󰀂 {ifname}",
        "tooltip-format-ethernet": "󰀂  {ipaddr}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "nospacing": 1,
        "interval": 5
    },
    "pulseaudio": {
        "format": "{icon}{volume}%",
        "format-bluetooth": "󰂰 {volume}%",
        "nospacing": 1,
        "tooltip-format": "Volume : {volume}%",
        "format-muted": "󰝟 ",
        "format-icons": {
            "headphone": " ",
            "default": [
                "󰕿 ",
                "󰖀 ",
                "󰕾 "
            ]
        },
        "on-click": "pavucontrol",
        "scroll-step": 1
    },
    "custom/launcher": {
        "format": "  ",
        "tooltip": false,
        "on-click": "~/.config/rofi/launchers/misc/launcher.sh &"
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": {
            "charging": [
                "󰢜",
                "󰂆",
                "󰂇",
                "󰂈",
                "󰢝",
                "󰂉",
                "󰢞",
                "󰂊",
                "󰂋",
                "󰂅"
            ],
            "default": [
                "󰁺",
                "󰁻",
                "󰁼",
                "󰁽",
                "󰁾",
                "󰁿",
                "󰂀",
                "󰂁",
                "󰂂",
                "󰁹"
            ]
        },
        "interval": 5,
        "states": {
            "warning": 25,
            "critical": 10
        },
        "tooltip": false
    },
    "custom/powermenu": {
        "format": "⏻ ",
        "tooltip": false,
        "on-click": "~/.config/rofi/powermenu/type-6/powermenu.sh &"
    },
    "mpd": {
        "format": "{stateIcon} {title}",
        "format-disconnected": " Disconnected",
        "format-stopped": " Stopped",
        "unknown-tag": "N/A",
        "interval": 2,
	    "state-icons": {
            "paused": "",
            "playing": ""
        },
        "on-click": "mpc toggle",
	    "tooltip-format": "MPD (connected)",
        "tooltip-format-disconnected": "MPD (disconnected)"
    },
    "mpris": {
	    "format": "{player_icon} {dynamic}",
	    "format-paused": "{status_icon}  <i>{dynamic}</i>",
	    "player-icons": {
		    "spotify": "",
		    "default": "🎵"
	     },
	     "dynamic-order": ["title"],
	     "interval": 5,
	     "status-icons": {
		     "paused": "⏸"
	     },
	     "ignored-players": ["firefox"]
     },
     "custom/weather": {
         "format": "{}",
         "format-alt": "{alt}",
         "format-alt-click": "click-left",
         "interval": 3600,
         "return-type": "json",
         "exec": "~/.config/waybar/weather-waybar-module.sh",
         "exec-if": "ping openweathermap.org -c1",
         "signal": 8
     }
}
